# Copy this file to .env and fill in real values. Never commit .env.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL (required in production)
DB_URL=jdbc:postgresql://localhost:5432/aiplatform
DB_USERNAME=aiplatform
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# Comma-separated list of allowed frontend origins (required in production)
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Timezone used for billing periods and scheduled tasks
APP_TIMEZONE=UTC
